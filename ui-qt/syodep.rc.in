// Windows resources for syodep.exe: the application icon and the version
// block Explorer shows under file properties. Generated by CMake from
// ui-qt/syodep.rc.in -- edit that, not the copy in the build directory.
//
// The icon path is substituted with forward slashes, which rc.exe accepts.

// Icon ordinal 1: Explorer and the taskbar use the lowest-numbered icon.
1 ICON "@SYODEP_ICON_RC_PATH@"

1 VERSIONINFO
FILEVERSION    @SYODEP_VERSION_COMMA@
PRODUCTVERSION @SYODEP_VERSION_COMMA@
FILEOS         0x4L        // VOS__WINDOWS32
FILETYPE       0x1L        // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0 = US English, Unicode.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "nexdep"
            VALUE "FileDescription",  "syodep - keyboard-first PDF reader"
            VALUE "FileVersion",      "@SYODEP_BUILD_VERSION@"
            VALUE "InternalName",     "syodep"
            VALUE "LegalCopyright",   "AGPL-3.0-or-later"
            VALUE "OriginalFilename", "syodep.exe"
            VALUE "ProductName",      "syodep"
            VALUE "ProductVersion",   "@SYODEP_BUILD_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
